class Solution:
    def kidsWithCandies(self, candies: list[int], extraCandies: int) -> list[bool]:
        result = []

        large = candies[0]
        for i in candies:
            if i > large:
                large = i

        for i in range(len(candies)):
            totalc = candies[i] + extraCandies
            if totalc >= large:
                result.append(True)
            else:
                result.append(False)
        return result
